# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    # Disable microphone support in audio_session (app only uses playback)
    # This removes the need for NSMicrophoneUsageDescription
    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'AUDIO_SESSION_MICROPHONE=0'
      ]
    end
  end

  # Fix fula_client Rust FFI symbol linking for Release builds.
  # Rust FFI symbols accessed via dlsym() at runtime are stripped because:
  #   1) The linker only pulls in referenced symbols from static archives
  #   2) The post-link strip removes global symbols
  # xcconfig-level OTHER_LDFLAGS changes are silently ignored (verified in build logs),
  # so we set flags directly on the Runner target in project.pbxproj (highest priority).
  force_load_path = '"${PODS_ROOT}/../.symlinks/plugins/fula_client/ios/Frameworks/FulaFlutter.xcframework/ios-arm64/libfula_flutter.a"'

  runner_project_path = File.join(installer.sandbox.root, '..', 'Runner.xcodeproj')
  runner_project = Xcodeproj::Project.open(runner_project_path)
  runner_target = runner_project.targets.find { |t| t.name == 'Runner' }

  runner_target.build_configurations.each do |config|
    # Preserve global symbols that dlsym() needs (default strips all in Release)
    config.build_settings['STRIP_STYLE'] = 'non-global-symbols'

    # Force-load all symbols from the Rust static archive
    flags = config.build_settings['OTHER_LDFLAGS'] || ['$(inherited)']
    flags = [flags] if flags.is_a?(String)
    unless flags.any? { |f| f.to_s.include?('force_load') }
      flags.push('-force_load')
      flags.push(force_load_path)
    end
    config.build_settings['OTHER_LDFLAGS'] = flags
  end

  runner_project.save

  # Also clean up broken conditioned lines from xcconfigs (previous fix attempts)
  ['debug', 'profile', 'release'].each do |config_name|
    xcconfig_path = "#{installer.sandbox.root}/Target Support Files/Pods-Runner/Pods-Runner.#{config_name}.xcconfig"
    next unless File.exist?(xcconfig_path)

    content = File.read(xcconfig_path)
    changed = false
    changed = true if content.gsub!(/^OTHER_LDFLAGS\[sdk=.*\].*\n?/, '')
    changed = true if content.gsub!(/^FULA_FLUTTER_LIB\[sdk=.*\].*\n?/, '')
    File.write(xcconfig_path, content) if changed
  end
end
